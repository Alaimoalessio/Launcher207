<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="gb.xxy.hr"/>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
    <application android:theme="@style/AppTheme" android:label="Peugeot Launcher"
        android:icon="@drawable/ic_home" android:allowBackup="false"
        android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="landscape" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".MediaAccessService"
            android:label="Peugeot Launcher - controllo musica"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <activity-alias android:name=".HomeEntry" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:label="Peugeot Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
