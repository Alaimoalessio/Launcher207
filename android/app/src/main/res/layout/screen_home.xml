<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
    <it.peugeot.launcher.ClockView android:id="@+id/clock" android:layout_width="402dp" android:layout_height="match_parent" android:importantForAccessibility="yes" />
    <View android:layout_width="1dp" android:layout_height="258dp" android:layout_gravity="center_vertical" android:background="@color/line" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="36dp">
        <TextView android:id="@+id/home_source" style="@style/Muted" android:text="@string/home_source" android:layout_marginBottom="24dp" />
        <TextView android:id="@+id/home_title" style="@style/Title" android:text="@string/home_title" android:textSize="46sp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/home_artist" style="@style/Muted" android:text="@string/home_artist" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <ImageButton android:id="@+id/home_prev" style="@style/IconButton" android:src="@drawable/ic_prev" android:contentDescription="@string/home_prev" />
            <ImageButton android:id="@+id/home_play" style="@style/IconButton" android:src="@drawable/ic_play" android:contentDescription="@string/home_play" android:background="@drawable/primary" android:tint="@color/ink" android:layout_width="94dp" />
            <ImageButton android:id="@+id/home_next" style="@style/IconButton" android:src="@drawable/ic_next" android:contentDescription="@string/home_next" />
        </LinearLayout>
        <Button android:id="@+id/home_fallback" style="@style/Button" android:text="@string/home_fallback" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>