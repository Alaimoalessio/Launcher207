<it.peugeot.launcher.FitLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/base">
    <LinearLayout android:layout_width="1024dp" android:layout_height="600dp" android:orientation="vertical" android:paddingStart="40dp" android:paddingEnd="40dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="74dp" android:gravity="center_vertical" android:baselineAligned="false">
            <Button android:id="@+id/brand" style="@style/Button" android:text="@string/brand" android:background="@android:color/transparent" android:textStyle="bold" />
            <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
            <TextView android:id="@+id/status" style="@style/Muted" android:text="@string/status" android:textSize="16sp" android:layout_marginEnd="16dp" />
            <ImageButton android:id="@+id/settings" style="@style/IconButton" android:src="@drawable/ic_settings" android:contentDescription="@string/settings" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
        <LinearLayout android:id="@+id/page_header" android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical" android:visibility="gone" android:baselineAligned="false">
            <ImageButton android:id="@+id/back" style="@style/IconButton" android:src="@drawable/ic_back" android:contentDescription="@string/back" />
            <TextView android:id="@+id/page_title" style="@style/Title" android:text="@string/page_title" android:layout_marginStart="12dp" />
        </LinearLayout>
        <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="16dp" android:paddingBottom="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="78dp" android:baselineAligned="false">
            <Button android:id="@+id/nav_home" style="@style/Dock" android:text="@string/nav_home" android:drawableStart="@drawable/ic_home" />
            <Button android:id="@+id/nav_auto" style="@style/Dock" android:text="@string/nav_auto" android:drawableStart="@drawable/ic_auto" />
            <Button android:id="@+id/nav_music" style="@style/Dock" android:text="@string/nav_music" android:drawableStart="@drawable/ic_music" />
            <Button android:id="@+id/nav_phone" style="@style/Dock" android:text="@string/nav_phone" android:drawableStart="@drawable/ic_phone" />
        </LinearLayout>
        <TextView android:id="@+id/mode" style="@style/Muted" android:text="@string/mode" android:layout_height="34dp" android:gravity="center_vertical" android:textSize="13sp" />
    </LinearLayout>
</it.peugeot.launcher.FitLayout>
