<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
    <LinearLayout android:layout_width="440dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/call_status" style="@style/Muted" android:text="@string/call_status" />
        <TextView android:id="@+id/number" style="@style/Title" android:text="@string/number" android:textSize="44sp" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="18dp" android:layout_marginBottom="20dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
            <Button android:id="@+id/call" style="@style/Primary" android:text="@string/call" android:layout_width="0dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/erase" style="@style/IconButton" android:src="@drawable/ic_erase" android:contentDescription="@string/erase" />
        </LinearLayout>
        <Button android:id="@+id/phone_fallback" style="@style/Button" android:text="@string/phone_fallback" android:visibility="gone" />
    </LinearLayout>
    <GridLayout android:id="@+id/keypad" android:layout_width="480dp" android:layout_height="300dp" android:layout_marginStart="24dp" android:layout_gravity="center_vertical" android:columnCount="3" android:rowCount="4">
        <Button android:id="@+id/digit_1" style="@style/Button" android:text="@string/digit_1" android:layout_width="152dp" android:layout_height="67dp" android:textSize="25sp" android:layout_row="0" android:layout_column="0" android:layout_margin="4dp" />
        <Button android:id="@+id/digit_2" style="@style/Button" android:text="@string/digit_2" android:layout_width="152dp" android:layout_height="67dp" android:textSize="25sp" android:layout_row="0" android:layout_column="1" android:layout_margin="4dp" />
        <Button android:id="@+id/digit_3" style="@style/Button" android:text="@string/digit_3" android:layout_width="152dp" android:layout_height="67dp" android:textSize="25sp" android:layout_row="0" android:layout_column="2" android:layout_margin="4dp" />
        <Button android:id="@+id/digit_4" style="@style/Button" android:text="@string/digit_4" android:layout_width="152dp" android:layout_height="67dp" android:textSize="25sp" android:layout_row="1" android:layout_column="0" android:layout_margin="4dp" />
        <Button android:id="@+id/digit_5" style="@style/Button" android:text="@string/digit_5" android:layout_width="152dp" android:layout_height="67dp" android:textSize="25sp" android:layout_row="1" android:layout_column="1" android:layout_margin="4dp" />
        <Button android:id="@+id/digit_6" style="@style/Button" android:text="@string/digit_6" android:layout_width="152dp" android:layout_height="67dp" android:textSize="25sp" android:layout_row="1" android:layout_column="2" android:layout_margin="4dp" />
        <Button android:id="@+id/digit_7" style="@style/Button" android:text="@string/digit_7" android:layout_width="152dp" android:layout_height="67dp" android:textSize="25sp" android:layout_row="2" android:layout_column="0" android:layout_margin="4dp" />
        <Button android:id="@+id/digit_8" style="@style/Button" android:text="@string/digit_8" android:layout_width="152dp" android:layout_height="67dp" android:textSize="25sp" android:layout_row="2" android:layout_column="1" android:layout_margin="4dp" />
        <Button android:id="@+id/digit_9" style="@style/Button" android:text="@string/digit_9" android:layout_width="152dp" android:layout_height="67dp" android:textSize="25sp" android:layout_row="2" android:layout_column="2" android:layout_margin="4dp" />
        <Button android:id="@+id/digit_star" style="@style/Button" android:text="@string/digit_star" android:layout_width="152dp" android:layout_height="67dp" android:textSize="25sp" android:layout_row="3" android:layout_column="0" android:layout_margin="4dp" />
        <Button android:id="@+id/digit_0" style="@style/Button" android:text="@string/digit_0" android:layout_width="152dp" android:layout_height="67dp" android:textSize="25sp" android:layout_row="3" android:layout_column="1" android:layout_margin="4dp" />
        <Button android:id="@+id/digit_hash" style="@style/Button" android:text="@string/digit_hash" android:layout_width="152dp" android:layout_height="67dp" android:textSize="25sp" android:layout_row="3" android:layout_column="2" android:layout_margin="4dp" />
    </GridLayout>
</LinearLayout>