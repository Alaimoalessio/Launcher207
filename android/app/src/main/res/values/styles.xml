<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/base</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:colorControlActivated">@color/accent</item>
    </style>
    <style name="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Title" parent="Text">
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Muted" parent="Text">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">19sp</item>
    </style>
    <style name="Button" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:minWidth">60dp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:background">@drawable/button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:layout_margin">4dp</item>
    </style>
    <style name="Primary" parent="Button">
        <item name="android:background">@drawable/primary</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="IconButton" parent="Button">
        <item name="android:layout_width">66dp</item>
        <item name="android:padding">18dp</item>
        <item name="android:tint">@color/text</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="Dock" parent="Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>